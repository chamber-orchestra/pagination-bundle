{
  "name": "chamber-orchestra/pagination-bundle",
  "type": "symfony-bundle",
  "description": "Symfony pagination bundle with support for arrays, Doctrine ORM repositories, queries, Twig rendering, and filter building",
  "keywords": [
    "symfony",
    "symfony-bundle",
    "pagination",
    "paginator",
    "paging",
    "doctrine",
    "orm",
    "twig",
    "filter",
    "api"
  ],
  "homepage": "https://github.com/chamber-orchestra/pagination-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Lukin",
      "email": "lukin.andrej@gmail.com",
      "homepage": "https://github.com/wtorsi",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.5",
    "symfony/dependency-injection": "8.1.*",
    "symfony/config": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/options-resolver": "8.1.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "symfony/test-pack": "^1.2",
    "symfony/form": "8.1.*",
    "chamber-orchestra/view-bundle": "8.1.*",
    "doctrine/orm": "3.6.*",
    "doctrine/doctrine-bundle": "3.3.*",
    "twig/twig": "^3.28",
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "symfony/uid": "8.1.*"
  },
  "autoload": {
    "psr-4": {
      "ChamberOrchestra\\PaginationBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "suggest": {
    "chamber-orchestra/view-bundle": "Required for PaginatedView (DataView wrapper with headers and normalization)",
    "twig/twig": "Required for Twig pagination rendering (render_pagination)"
  },
  "minimum-stability": "stable",
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse",
    "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
  }
}
